#!/usr/bin/env python3
"""Validate every skills/*/SKILL.md in the repo.

Zero dependencies by design: front matter is restricted to simple
`key: "value"` lines, so it parses identically in every agent harness
and in this 40-line parser. No YAML edge cases, no PyYAML install.

Usage: validate-skills [repo-root]
Exit code 0 when all skills are valid, 1 otherwise.
"""

import os
import re
import sys

NAME_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
KEY_RE = re.compile(r"^([A-Za-z0-9_-]+):\s*(.*)$")
MAX_DESCRIPTION_LEN = 200
MAX_BODY_LINES = 120
ALLOWED_KEYS = ("name", "description", "version", "license", "allowed-tools")
REQUIRED_SECTIONS = ("## When to use", "## Workflow", "## Pitfalls")


def parse_front_matter(text):
    """Return (data, raw_lines, body, error). data maps key -> unquoted value,
    raw_lines maps key -> the raw value text (to check quoting)."""
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return None, None, None, "front matter must open with --- on line 1"
    data, raw = {}, {}
    for i, line in enumerate(lines[1:], start=2):
        if line.strip() == "---":
            body = "\n".join(lines[i:])
            return data, raw, body, None
        if not line.strip():
            continue
        m = KEY_RE.match(line)
        if not m:
            return None, None, None, "line %d: not a simple `key: value` pair" % i
        key, value = m.group(1), m.group(2).strip()
        if key in data:
            return None, None, None, "line %d: duplicate key `%s`" % (i, key)
        raw[key] = value
        if len(value) >= 2 and value[0] == '"' and value[-1] == '"':
            value = value[1:-1]
        data[key] = value
    return None, None, None, "front matter never closed with ---"


def check_skill(skills_dir, name, seen_names):
    errors = []
    path = os.path.join(skills_dir, name)
    skill_md = os.path.join(path, "SKILL.md")
    rel = os.path.join("skills", name, "SKILL.md")

    if os.path.islink(path) and not os.path.exists(path):
        return ["skills/%s: broken symlink (target missing)" % name]
    if not os.path.isfile(skill_md):
        return ["skills/%s: missing SKILL.md" % name]

    with open(skill_md, encoding="utf-8") as fh:
        text = fh.read()

    data, raw, body, err = parse_front_matter(text)
    if err:
        return ["%s: %s" % (rel, err)]

    for field in ("name", "description"):
        if not data.get(field, "").strip():
            errors.append("%s: missing non-empty field `%s`" % (rel, field))

    fm_name = data.get("name", "").strip()
    if fm_name:
        if fm_name != name:
            errors.append(
                "%s: front matter name `%s` does not match directory `%s`"
                % (rel, fm_name, name)
            )
        if not NAME_RE.match(fm_name):
            errors.append("%s: name must be kebab-case ([a-z0-9-])" % rel)
        if fm_name in seen_names:
            errors.append("%s: duplicate skill name `%s`" % (rel, fm_name))
        seen_names.add(fm_name)

    desc_raw = raw.get("description", "")
    if desc_raw and not (desc_raw.startswith('"') and desc_raw.endswith('"')):
        errors.append("%s: description must be double-quoted" % rel)
    if len(data.get("description", "")) > MAX_DESCRIPTION_LEN:
        errors.append(
            "%s: description exceeds %d chars" % (rel, MAX_DESCRIPTION_LEN)
        )

    for key in data:
        if key not in ALLOWED_KEYS:
            errors.append(
                "%s: unknown front matter key `%s` (allowed: %s)"
                % (rel, key, ", ".join(ALLOWED_KEYS))
            )

    if body is None or not body.strip():
        errors.append("%s: body is empty — a skill must contain a workflow" % rel)
    else:
        body_lines = [line.rstrip() for line in body.strip("\n").split("\n")]
        if len(body_lines) > MAX_BODY_LINES:
            errors.append(
                "%s: body is %d lines (max %d) — move detail to references/ or scripts/"
                % (rel, len(body_lines), MAX_BODY_LINES)
            )
        first = next((line for line in body_lines if line.strip()), "")
        if fm_name and first != "# %s" % fm_name:
            errors.append("%s: body must open with the heading `# %s`" % (rel, fm_name))
        for section in REQUIRED_SECTIONS:
            hits = body_lines.count(section)
            if hits != 1:
                errors.append(
                    "%s: body must contain exactly one `%s` section (found %d)"
                    % (rel, section, hits)
                )

    errors.extend(check_helper_scripts(path, name))
    return errors


def check_helper_scripts(skill_path, name):
    """Helper scripts must be executable and carry a shebang: a fresh clone
    preserves the mode bit, and a non-executable helper fails silently when
    an agent tries to run it."""
    errors = []
    scripts_dir = os.path.join(skill_path, "scripts")
    if not os.path.isdir(scripts_dir):
        return errors
    for fn in sorted(os.listdir(scripts_dir)):
        sp = os.path.join(scripts_dir, fn)
        if not os.path.isfile(sp):
            continue
        rel = os.path.join("skills", name, "scripts", fn)
        if not os.access(sp, os.X_OK):
            errors.append("%s: helper script is not executable (chmod +x)" % rel)
        with open(sp, "rb") as fh:
            if fh.read(2) != b"#!":
                errors.append("%s: helper script missing shebang line" % rel)
    return errors


def main():
    root = sys.argv[1] if len(sys.argv) > 1 else os.path.dirname(
        os.path.dirname(os.path.abspath(__file__))
    )
    skills_dir = os.path.join(root, "skills")
    if not os.path.isdir(skills_dir):
        print("validate-skills: no skills/ directory under %s" % root)
        return 1

    names = sorted(
        n for n in os.listdir(skills_dir)
        if os.path.isdir(os.path.join(skills_dir, n))
        or os.path.islink(os.path.join(skills_dir, n))
    )
    errors, seen = [], set()
    for name in names:
        errors.extend(check_skill(skills_dir, name, seen))

    if errors:
        for e in errors:
            print("FAIL %s" % e)
        print("validate-skills: %d error(s) across %d skill(s)" % (len(errors), len(names)))
        return 1
    print("validate-skills: %d skill(s) OK" % len(names))
    return 0


if __name__ == "__main__":
    sys.exit(main())
