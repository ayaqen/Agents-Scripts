#!/usr/bin/env python3
"""Validate docs/*.md front matter.

Every doc must declare `summary` and `read_when` so agents can decide
whether a doc is worth loading without reading its body.

Usage: validate-docs [repo-root]
Exit code 0 when all docs are valid, 1 otherwise.
"""

import os
import re
import sys

KEY_RE = re.compile(r"^([A-Za-z0-9_-]+):\s*(.*)$")
REQUIRED = ("summary", "read_when")


def parse_front_matter(text):
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return None, "front matter must open with --- on line 1"
    data = {}
    for i, line in enumerate(lines[1:], start=2):
        if line.strip() == "---":
            return data, None
        if not line.strip():
            continue
        m = KEY_RE.match(line)
        if not m:
            return None, "line %d: not a simple `key: value` pair" % i
        value = m.group(2).strip()
        if len(value) >= 2 and value[0] == '"' and value[-1] == '"':
            value = value[1:-1]
        data[m.group(1)] = value
    return None, "front matter never closed with ---"


def main():
    root = sys.argv[1] if len(sys.argv) > 1 else os.path.dirname(
        os.path.dirname(os.path.abspath(__file__))
    )
    docs_dir = os.path.join(root, "docs")
    if not os.path.isdir(docs_dir):
        print("validate-docs: no docs/ directory under %s" % root)
        return 1

    errors, count = [], 0
    for dirpath, _dirnames, filenames in os.walk(docs_dir):
        for fn in sorted(filenames):
            if not fn.endswith(".md"):
                continue
            count += 1
            path = os.path.join(dirpath, fn)
            rel = os.path.relpath(path, root)
            with open(path, encoding="utf-8") as fh:
                data, err = parse_front_matter(fh.read())
            if err:
                errors.append("%s: %s" % (rel, err))
                continue
            for field in REQUIRED:
                if not data.get(field, "").strip():
                    errors.append("%s: missing non-empty field `%s`" % (rel, field))

    if errors:
        for e in errors:
            print("FAIL %s" % e)
        print("validate-docs: %d error(s) across %d doc(s)" % (len(errors), count))
        return 1
    print("validate-docs: %d doc(s) OK" % count)
    return 0


if __name__ == "__main__":
    sys.exit(main())
