#!/usr/bin/env python3
"""Validate the Claude Code plugin packaging in .claude-plugin/.

Checks plugin.json and marketplace.json against the documented contract:
required fields present, names kebab-case and consistent across the two
files, and every relative plugin source resolving to a real directory.
A broken manifest fails silently at install time on the user's machine —
this catches it in CI instead.

Usage: validate-plugin [repo-root]
Exit code 0 when the packaging is valid, 1 otherwise. A repo without a
.claude-plugin/ directory passes (plugin packaging is optional).
"""

import json
import os
import re
import sys

NAME_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")


def load_json(path, rel, errors):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except ValueError as e:
        errors.append("%s: invalid JSON: %s" % (rel, e))
        return None


def main():
    root = sys.argv[1] if len(sys.argv) > 1 else os.path.dirname(
        os.path.dirname(os.path.abspath(__file__))
    )
    plugin_dir = os.path.join(root, ".claude-plugin")
    if not os.path.isdir(plugin_dir):
        print("validate-plugin: OK (no .claude-plugin/ directory)")
        return 0

    errors = []
    plugin_name = None

    plugin_path = os.path.join(plugin_dir, "plugin.json")
    if os.path.isfile(plugin_path):
        data = load_json(plugin_path, ".claude-plugin/plugin.json", errors)
        if isinstance(data, dict):
            plugin_name = data.get("name", "")
            if not plugin_name or not isinstance(plugin_name, str):
                errors.append(".claude-plugin/plugin.json: `name` is required")
            elif not NAME_RE.match(plugin_name):
                errors.append(".claude-plugin/plugin.json: `name` must be kebab-case")

    mkt_path = os.path.join(plugin_dir, "marketplace.json")
    if os.path.isfile(mkt_path):
        data = load_json(mkt_path, ".claude-plugin/marketplace.json", errors)
        if isinstance(data, dict):
            rel = ".claude-plugin/marketplace.json"
            if not data.get("name") or not NAME_RE.match(str(data.get("name"))):
                errors.append("%s: `name` is required and must be kebab-case" % rel)
            owner = data.get("owner")
            if not isinstance(owner, dict) or not owner.get("name"):
                errors.append("%s: `owner.name` is required" % rel)
            plugins = data.get("plugins")
            if not isinstance(plugins, list) or not plugins:
                errors.append("%s: `plugins` must be a non-empty array" % rel)
            else:
                for i, entry in enumerate(plugins):
                    where = "%s: plugins[%d]" % (rel, i)
                    if not isinstance(entry, dict):
                        errors.append("%s: must be an object" % where)
                        continue
                    if not entry.get("name"):
                        errors.append("%s: `name` is required" % where)
                    source = entry.get("source")
                    if source is None:
                        errors.append("%s: `source` is required" % where)
                    elif isinstance(source, str):
                        if not source.startswith("./"):
                            errors.append(
                                "%s: relative source must start with ./" % where
                            )
                        elif ".." in source.split("/"):
                            errors.append("%s: source must not contain .." % where)
                        elif not os.path.isdir(
                            os.path.normpath(os.path.join(root, source))
                        ):
                            errors.append(
                                "%s: source path does not exist: %s" % (where, source)
                            )
                        elif (
                            os.path.normpath(os.path.join(root, source))
                            == os.path.normpath(root)
                            and plugin_name
                            and entry.get("name") != plugin_name
                        ):
                            errors.append(
                                "%s: name `%s` does not match plugin.json name `%s`"
                                % (where, entry.get("name"), plugin_name)
                            )

    if not os.path.isfile(plugin_path) and not os.path.isfile(mkt_path):
        errors.append(".claude-plugin/ exists but contains neither plugin.json nor marketplace.json")

    if errors:
        for e in errors:
            print("FAIL %s" % e)
        print("validate-plugin: %d error(s)" % len(errors))
        return 1
    print("validate-plugin: packaging OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
