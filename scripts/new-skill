#!/usr/bin/env bash
# Scaffold a new skill from templates/skill and validate it.
#
# Usage: new-skill [--root <dir>] <name> "<description>"
#   name         kebab-case skill name (becomes skills/<name>/)
#   description  one-line routing phrase; required so skills never ship
#                with placeholder descriptions
set -euo pipefail

script_dir=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$script_dir/.." && pwd)

if [ "${1:-}" = "--root" ]; then
  root=$(cd "$2" && pwd)
  shift 2
fi

if [ $# -ne 2 ]; then
  echo "usage: new-skill [--root <dir>] <name> \"<description>\"" >&2
  exit 2
fi

name=$1
description=$2

case "$name" in
  *[!a-z0-9-]* | -* | *- | "")
    echo "new-skill: name must be kebab-case ([a-z0-9] with single hyphens): $name" >&2
    exit 1
    ;;
esac

# Front matter double-quotes the description, and multi-line values can't be
# represented at all — reject both up front instead of writing a broken skill.
case "$description" in
  *'"'*)
    echo "new-skill: description must not contain double quotes" >&2
    exit 1
    ;;
  *$'\n'*)
    echo "new-skill: description must be a single line" >&2
    exit 1
    ;;
esac

dest="$root/skills/$name"
if [ -e "$dest" ]; then
  echo "new-skill: skills/$name already exists" >&2
  exit 1
fi

template="$script_dir/../templates/skill/SKILL.md"
if [ ! -f "$template" ]; then
  echo "new-skill: template not found: $template" >&2
  exit 1
fi

mkdir -p "$dest"
# Literal substitution via python3, not sed: sed treats &, /, and \ in the
# replacement specially and silently corrupts descriptions containing them.
NS_NAME="$name" NS_DESCRIPTION="$description" NS_TEMPLATE="$template" \
  NS_DEST="$dest/SKILL.md" python3 - <<'PY'
import os

with open(os.environ["NS_TEMPLATE"], encoding="utf-8") as fh:
    text = fh.read()
text = text.replace("{{NAME}}", os.environ["NS_NAME"])
text = text.replace("{{DESCRIPTION}}", os.environ["NS_DESCRIPTION"])
with open(os.environ["NS_DEST"], "w", encoding="utf-8") as fh:
    fh.write(text)
PY

"$script_dir/validate-skills" "$root"
echo "new-skill: created skills/$name/SKILL.md — now replace the TODO sections"
