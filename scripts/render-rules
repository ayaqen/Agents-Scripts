#!/usr/bin/env python3
"""Render skills/ + AGENTS.md into other harnesses' native rule formats.

One source of truth: skills and shared rules are authored once, here.
This renderer derives, byte-stably:

  cursor    .cursor/rules/00-agents-scripts.mdc   (alwaysApply: shared rules)
            .cursor/rules/<skill>.mdc             (agent-requested, routed
                                                   by description)
  copilot   .github/copilot-instructions.md       (shared rules + catalog —
                                                   always in context, so
                                                   bodies are indexed, not
                                                   inlined: token discipline)
  windsurf  .windsurfrules                        (same content as copilot)
  gemini    GEMINI.md                             (same content as copilot)

Rendered outputs are COMMITTED, and --check makes drift a CI failure:
edit skills/ or AGENTS.md, re-run this script, commit both.

Usage: render-rules [--root DIR] [--check] [cursor|copilot|windsurf|gemini|all]
Exit 0 on success / in sync; 1 on drift in --check mode.
"""

import os
import re
import sys

KEY_RE = re.compile(r"^([A-Za-z0-9_-]+):\s*(.*)$")
GEN_NOTE = ("Generated by scripts/render-rules from skills/ and AGENTS.md - "
            "edit the sources, not this file.")


def parse_skill(path):
    with open(path, encoding="utf-8") as fh:
        lines = fh.read().split("\n")
    data, body_start = {}, None
    for i, line in enumerate(lines[1:], start=1):
        if line.strip() == "---":
            body_start = i + 1
            break
        m = KEY_RE.match(line)
        if m:
            value = m.group(2).strip()
            if len(value) >= 2 and value[0] == '"' and value[-1] == '"':
                value = value[1:-1]
            data[m.group(1)] = value
    body = "\n".join(lines[body_start:]).strip("\n") if body_start else ""
    return data.get("name", ""), data.get("description", ""), body


def load_sources(root):
    skills = []
    skills_dir = os.path.join(root, "skills")
    for name in sorted(os.listdir(skills_dir)):
        skill_md = os.path.join(skills_dir, name, "SKILL.md")
        if os.path.isfile(skill_md):
            skills.append(parse_skill(skill_md))
    with open(os.path.join(root, "AGENTS.md"), encoding="utf-8") as fh:
        agents_text = fh.read().strip("\n")
    return skills, agents_text


def catalog_document(agents_text, skills, harness_note):
    out = ["<!-- %s -->" % GEN_NOTE, "", harness_note, "", agents_text, "",
           "## Skill catalog", "",
           "Workflow skills available in this repo's skills/ directory; open"
           " skills/<name>/SKILL.md for the full operational workflow before"
           " performing one of these tasks.", ""]
    for name, description, _body in skills:
        out.append("- **%s** — %s" % (name, description))
    out.append("")
    return "\n".join(out)


def render(root):
    skills, agents_text = load_sources(root)
    files = {}

    files[".cursor/rules/00-agents-scripts.mdc"] = (
        "---\ndescription: \"Shared hard rules for AI agent sessions"
        " (Agents-Scripts)\"\nglobs:\nalwaysApply: true\n---\n\n"
        "<!-- %s -->\n\n%s\n" % (GEN_NOTE, agents_text)
    )
    for name, description, body in skills:
        files[".cursor/rules/%s.mdc" % name] = (
            "---\ndescription: \"%s\"\nglobs:\nalwaysApply: false\n---\n\n"
            "<!-- %s -->\n\n%s\n" % (description, GEN_NOTE, body)
        )

    copilot = catalog_document(
        agents_text, skills,
        "These instructions apply to all work in this repository.")
    files[".github/copilot-instructions.md"] = copilot
    files[".windsurfrules"] = copilot
    files["GEMINI.md"] = copilot
    return files


def main():
    args = sys.argv[1:]
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    check = False
    target = "all"
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--root":
            i += 1
            root = os.path.abspath(args[i])
        elif a == "--check":
            check = True
        elif a in ("cursor", "copilot", "windsurf", "gemini", "all"):
            target = a
        else:
            print("render-rules: unknown argument %s" % a, file=sys.stderr)
            return 2
        i += 1

    files = render(root)
    if target != "all":
        prefixes = {
            "cursor": (".cursor/",),
            "copilot": (".github/copilot-instructions.md",),
            "windsurf": (".windsurfrules",),
            "gemini": ("GEMINI.md",),
        }[target]
        files = {p: c for p, c in files.items() if p.startswith(prefixes)}

    if check:
        stale = []
        for rel, content in sorted(files.items()):
            path = os.path.join(root, rel)
            if not os.path.isfile(path):
                stale.append("%s: missing — run scripts/render-rules" % rel)
                continue
            with open(path, encoding="utf-8") as fh:
                if fh.read() != content:
                    stale.append("%s: stale — run scripts/render-rules" % rel)
        if stale:
            for s in stale:
                print("FAIL %s" % s)
            print("render-rules: %d rendered file(s) out of sync with sources"
                  % len(stale))
            return 1
        print("render-rules: %d rendered file(s) in sync" % len(files))
        return 0

    for rel, content in sorted(files.items()):
        path = os.path.join(root, rel)
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(content)
        print("rendered %s" % rel)
    print("render-rules: %d file(s) rendered" % len(files))
    return 0


if __name__ == "__main__":
    sys.exit(main())
