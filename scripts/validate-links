#!/usr/bin/env python3
"""Check that relative markdown links resolve to real files.

Scans every .md file in the repo (skipping .git and junk dirs), strips
fenced code blocks, and verifies each relative link target exists on disk.
External links (http/https/mailto) and pure #anchors are skipped. Dead
internal links are the fastest-rotting part of a docs-heavy repo; this
keeps them out of main.

Usage: validate-links [repo-root]
Exit code 0 when all links resolve, 1 otherwise.
"""

import os
import re
import sys

LINK_RE = re.compile(r"\[[^\]]*\]\(([^)\s]+)\)")
FENCE_RE = re.compile(r"```.*?```", re.S)
SKIP_DIRS = {".git", "node_modules", "tmp", ".venv"}
EXTERNAL_PREFIXES = ("http://", "https://", "mailto:", "#")


def main():
    root = sys.argv[1] if len(sys.argv) > 1 else os.path.dirname(
        os.path.dirname(os.path.abspath(__file__))
    )
    errors, checked = [], 0
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = sorted(d for d in dirnames if d not in SKIP_DIRS)
        for fn in sorted(filenames):
            if not fn.endswith(".md"):
                continue
            path = os.path.join(dirpath, fn)
            rel = os.path.relpath(path, root)
            with open(path, encoding="utf-8") as fh:
                text = FENCE_RE.sub("", fh.read())
            for m in LINK_RE.finditer(text):
                target = m.group(1)
                if target.startswith(EXTERNAL_PREFIXES) or "://" in target:
                    continue
                target_path = target.split("#", 1)[0]
                if not target_path:
                    continue
                checked += 1
                resolved = os.path.normpath(
                    os.path.join(os.path.dirname(path), target_path)
                )
                if not os.path.exists(resolved):
                    errors.append("%s: dead link -> %s" % (rel, target))

    if errors:
        for e in errors:
            print("FAIL %s" % e)
        print("validate-links: %d dead link(s) of %d checked" % (len(errors), checked))
        return 1
    print("validate-links: %d relative link(s) OK" % checked)
    return 0


if __name__ == "__main__":
    sys.exit(main())
